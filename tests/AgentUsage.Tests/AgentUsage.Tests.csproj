<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No RID and no -windows: these tests are the cross-platform evidence. They run on the
         Linux and macOS CI runners, which is the only place the portable half is ever executed
         by anything other than a user. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentUsage.Core\AgentUsage.Core.csproj" />
  </ItemGroup>

</Project>
